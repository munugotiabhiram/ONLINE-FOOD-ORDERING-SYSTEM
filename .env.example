# Server Port
PORT=5000

# JWT Secret for Session Management
JWT_SECRET=super_secret_foodverse_jwt_key_2026_modern_3d_platform

# Database Configuration (Set DB_TYPE=mysql for MySQL or DB_TYPE=sqlite for zero-config embedded SQLite)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodverse_db

# Google OAuth 2.0 Credentials
# Get your Client ID and Client Secret from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Demo User Credentials (shown on login page)
DEMO_USER_EMAIL=demo@foodverse.com
DEMO_USER_PASSWORD=demo123
DEMO_ADMIN_EMAIL=admin@foodverse.com
DEMO_ADMIN_PASSWORD=admin123
